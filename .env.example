# Immutable Common Auth subject of the existing vault owner; required for HTTP.
# Obtain from Common Auth account identity, never from email or role.
LEGACY_OWNER_SUB=
# Container paths. Persist ciphertext and private keys in separate host mounts.
TENANTS_DIR=/tenants
TENANT_KEYS_DIR=/tenant-keys
# Gateway must protect every public route and replace x-lost-plus-* headers.
# Only the gateway may access the loopback backend; it owns CORS and preflight.
# Before startup: create /var/lib/passage-mcp/tenants and
# /etc/passage-mcp/tenant-keys owned by UID:GID 1001:1001 with mode 0700.
# Back up tenant keys securely and separately; losing a key loses its vault.
# Existing owner store and age identity remain at their current mounts.
